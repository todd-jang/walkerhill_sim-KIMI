{
  "$schema_version": "1.1.0",
  "contract_name": "WISE_HILLINK_ONTOLOGY_MAP",
  "description": "워커힐 거시 L2(수요/수용량)와 미시 L5(동선/소비) 간의 정적 온톨로지 매핑 계약",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "pseudonymousId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "비가역 또는 접근 통제된 가명 ID. 이름·전화번호·이메일 등 직접 식별자를 넣지 않는다."
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 통화 코드"
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency", "unit"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"$ref": "#/$defs/currencyCode"},
        "unit": {"$ref": "#/$defs/moneyUnit"},
        "tax_included": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "studyDesign": {
      "enum": [
        "randomized",
        "observational",
        "synthetic",
        "synthetic_randomized"
      ]
    },
    "assignmentLevel": {
      "enum": ["customer", "reservation", "session", "stay_date_cluster", "other"]
    },
    "assignedArm": {
      "enum": ["control", "treatment", "not_randomized"]
    },
    "exposureStatus": {
      "enum": ["shown", "eligible_not_shown", "unknown"]
    },
    "bookingOutcome": {
      "enum": ["booked", "not_booked", "unknown", "not_applicable"]
    },
    "cancellationOutcome": {
      "enum": ["kept", "cancelled", "pending", "not_applicable", "unknown"]
    },
    "outcomeStatus": {
      "enum": ["complete", "pending", "censored"]
    },
    "dataOrigin": {
      "enum": [
        "approved_pms_extract",
        "randomized_experiment",
        "observational_extract",
        "synthetic_fixture",
        "aggregate_reference"
      ]
    },
    "moneyUnit": {
      "enum": ["per_stay", "per_night", "per_person", "per_item", "total"]
    },
    "discountKind": {
      "enum": ["none", "percentage", "fixed_amount", "other"]
    },
    "discountUnit": {
      "enum": ["percent", "amount", "not_applicable"]
    },
    "availabilityStatus": {
      "enum": ["available", "limited", "unavailable", "unknown"]
    },
    "availabilityUnit": {
      "enum": ["room", "room_night", "offer_unit", "unknown"]
    },
    "completenessStatus": {
      "enum": ["complete", "partial", "unknown"]
    },
    "qualityFlag": {
      "enum": ["estimated", "imputed", "right_censored", "mapping_unresolved", "source_conflict", "other"]
    },
    "identifierProtectionMethod": {
      "enum": ["keyed_hmac", "token_vault", "source_deidentified", "synthetic"]
    },
    "identityMappingAccess": {
      "enum": ["separate_restricted", "none"]
    },
    "weekday": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 7,
      "description": "ISO weekday: Monday=1 ... Sunday=7"
    },
    "canonicalBuildingId": {
      "enum": [
        "WISE:Building:GRAND",
        "WISE:Building:VISTA",
        "WISE:Building:DOUGLAS"
      ]
    },
    "canonicalPromotionId": {
      "enum": [
        "WISE:Promotion:none",
        "WISE:Promotion:breakfast",
        "WISE:Promotion:package"
      ]
    },
    "canonicalSkuId": {
      "enum": [
        "WISE:SKU:SKU_THE_BUFFET_ADULT_2P",
        "WISE:SKU:SKU_PIZZA_HILL_COUPON_50K",
        "WISE:SKU:SKU_SAUNA_ADULT_2P"
      ]
    },
    "canonicalRoomTypeId": {
      "not": {},
      "description": "현재 확정된 WISE 객실 유형 코드가 없음. 온톨로지 등록 전에는 unmapped로 유지."
    },
    "canonicalEventId": {
      "not": {},
      "description": "현재 확정된 WISE 행사 코드가 없음. 온톨로지 등록 전에는 unmapped로 유지."
    },
    "canonicalSeasonId": {
      "not": {},
      "description": "현재 확정된 WISE 시즌 코드가 없음. 온톨로지 등록 전에는 unmapped로 유지."
    },
    "buildingBinding": {
      "allOf": [
        {"$ref": "#/$defs/conceptBinding"},
        {
          "if": {"properties": {"mapping_status": {"const": "mapped"}}},
          "then": {"properties": {"canonical_id": {"$ref": "#/$defs/canonicalBuildingId"}}}
        }
      ]
    },
    "promotionBinding": {
      "allOf": [
        {"$ref": "#/$defs/conceptBinding"},
        {
          "if": {"properties": {"mapping_status": {"const": "mapped"}}},
          "then": {"properties": {"canonical_id": {"$ref": "#/$defs/canonicalPromotionId"}}}
        }
      ]
    },
    "productBinding": {
      "allOf": [
        {"$ref": "#/$defs/conceptBinding"},
        {
          "if": {"properties": {"mapping_status": {"const": "mapped"}}},
          "then": {"properties": {"canonical_id": {"$ref": "#/$defs/canonicalSkuId"}}}
        }
      ]
    },
    "roomTypeBinding": {
      "allOf": [
        {"$ref": "#/$defs/conceptBinding"},
        {
          "if": {"properties": {"mapping_status": {"const": "mapped"}}},
          "then": {"properties": {"canonical_id": {"$ref": "#/$defs/canonicalRoomTypeId"}}}
        }
      ]
    },
    "eventBinding": {
      "allOf": [
        {"$ref": "#/$defs/conceptBinding"},
        {
          "if": {"properties": {"mapping_status": {"const": "mapped"}}},
          "then": {"properties": {"canonical_id": {"$ref": "#/$defs/canonicalEventId"}}}
        }
      ]
    },
    "seasonBinding": {
      "allOf": [
        {"$ref": "#/$defs/conceptBinding"},
        {
          "if": {"properties": {"mapping_status": {"const": "mapped"}}},
          "then": {"properties": {"canonical_id": {"$ref": "#/$defs/canonicalSeasonId"}}}
        }
      ]
    },
    "conceptBinding": {
      "type": "object",
      "required": ["source_system", "source_code", "mapping_status"],
      "properties": {
        "source_system": {"$ref": "#/$defs/nonEmptyString"},
        "source_code": {"$ref": "#/$defs/nonEmptyString"},
        "display": {"type": ["string", "null"]},
        "canonical_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "mapping_status": {"enum": ["mapped", "unmapped"]},
        "mapping_basis": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mapping_status": {"const": "mapped"}}},
          "then": {"properties": {"canonical_id": {"type": "string"}}},
          "else": {"properties": {"canonical_id": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "experiment_data_contract": {
    "schema": "wise_sim/schemas/reservation_exposure.schema.json",
    "contract_id": "WISE:experiment:reservation-exposure:v1",
    "record_grain": "one eligible experimental or observational unit × one offer",
    "causal_use_requires": [
      "randomized assignment recorded before offer exposure",
      "eligible units in both assigned arms, including unexposed and non-booked units",
      "offer price and outcome linked to the same pseudonymous unit",
      "outcome observation window and cancellations reported"
    ],
    "data_origin_terms": [
      "approved_pms_extract",
      "randomized_experiment",
      "observational_extract",
      "synthetic_fixture",
      "aggregate_reference"
    ],
    "assignment_level_terms": [
      "customer",
      "reservation",
      "session",
      "stay_date_cluster",
      "other"
    ],
    "ontology_rules": {
      "mapped_terms_require_canonical_id": true,
      "unmapped_terms_preserve_source_system_and_code": true,
      "unknown_room_types_must_remain_unmapped_until_added_to_ontology": true,
      "unknown_offer_products_must_remain_unmapped_until_added_to_ontology": true,
      "direct_personal_identifiers_allowed": false
    }
  },
  "canonical_terms": {
    "building": {
      "GRAND": "WISE:Building:GRAND",
      "VISTA": "WISE:Building:VISTA",
      "DOUGLAS": "WISE:Building:DOUGLAS"
    },
    "promotion": {
      "none": "WISE:Promotion:none",
      "breakfast": "WISE:Promotion:breakfast",
      "package": "WISE:Promotion:package"
    },
    "sku": {
      "SKU_THE_BUFFET_ADULT_2P": "WISE:SKU:SKU_THE_BUFFET_ADULT_2P",
      "SKU_PIZZA_HILL_COUPON_50K": "WISE:SKU:SKU_PIZZA_HILL_COUPON_50K",
      "SKU_SAUNA_ADULT_2P": "WISE:SKU:SKU_SAUNA_ADULT_2P"
    },
    "room_type": {},
    "season": {},
    "event": {}
  },
  "principles": {
    "zero_llm_mapping": true,
    "hierarchy_model": "MASTER_DETAIL",
    "master_authority": "WISE_L2_ENGINE_580_ROOMS",
    "detail_authority": "HILLINK_L5_CONSUMPTION_LEDGER",
    "join_key": "stay_id"
  },
  "external_reference_inputs": {
    "repository": "https://github.com/BK8909/Hillink",
    "room_reference": {
      "path": "hillink/docs/data/ontology_inverse_followup_shh_20261013/객실_온톨로지참고계수_31일.csv",
      "role": "AGGREGATE_REFERENCE_ONLY",
      "source_room_count": 801,
      "simulation_room_count": 580,
      "building_mapping": {
        "그랜드": "GRAND",
        "비스타": "VISTA",
        "더글라스": "DOUGLAS"
      },
      "calibration_allowed": false,
      "limitation": "날짜·목적·행사효과가 섞인 온톨로지 참고계수; PMS 예약 원장이나 독립 실험 데이터가 아님"
    },
    "instagram_persona_sample": {
      "path": "hillink/docs/instagram_persona_sample.csv",
      "role": "ANONYMIZED_BEHAVIORAL_EVIDENCE",
      "calibration_allowed": false,
      "limitation": "게시물 표본이며 실제 예약·가격 노출·무작위 배정 자료가 아님"
    },
    "evidence_chain": {
      "path": "docs/evidence_chain_20261010.csv",
      "role": "QUALITATIVE_CROSS_EVIDENCE",
      "calibration_allowed": false,
      "limitation": "가설·모델 결과·제약을 기록한 근거표이며 관측 단위별 실험 데이터가 아님"
    }
  },
  "room_inventory_allocation": {
    "total_rooms": 580,
    "basis_source": "객실_온톨로지참고계수_31일.csv (실제 801실 비례 분할)",
    "buildings": {
      "GRAND": {
        "allocated_rooms": 367,
        "ratio": 0.633,
        "target_archetypes": ["family", "foreign", "business"]
      },
      "VISTA": {
        "allocated_rooms": 177,
        "ratio": 0.305,
        "target_archetypes": ["couple"]
      },
      "DOUGLAS": {
        "allocated_rooms": 36,
        "ratio": 0.062,
        "target_archetypes": ["premium"]
      }
    }
  },
  "archetype_to_profile_binding": {
    "selection_rule": "DETERMINISTIC_ROUND_ROBIN",
    "formula": "selected_profile = profile_pool[persona_id % len(profile_pool)]",
    "mappings": {
      "family": {
        "description": "다인 가족 / 키즈 / 피자힐 선호",
        "default_building": "GRAND",
        "profile_pool": ["IG02_family_pool", "PH23_kids_pizza", "blog18_grand_family"]
      },
      "couple": {
        "description": "2인 호캉스 / 리버뷰 / 럭스바 선호",
        "default_building": "VISTA",
        "profile_pool": ["PH29_anniversary", "blog33_vista_river", "luxbar_couple_01"]
      },
      "business": {
        "description": "1인 단기 출장 / 클럽라운지 / 조식 중심",
        "default_building": "GRAND",
        "profile_pool": ["corp_walkerhill_single", "blog05_biz_club"]
      },
      "foreign": {
        "description": "외국인 관광 / 장기 2~3박",
        "default_building": "GRAND",
        "profile_pool": ["inbound_asia_stay3", "tourist_grand_04"]
      },
      "premium": {
        "description": "성인 전용 조용한 휴식 / 더글라스 / 미식 코스",
        "default_building": "DOUGLAS",
        "profile_pool": ["douglas_quiet_rest", "vista_spa_suite", "gourmet_ondal_vip"]
      }
    }
  },
  "promo_to_sku_binding": {
    "none": {
      "description": "객실 온리 (부대시설 현장 결제)",
      "included_skus": []
    },
    "breakfast": {
      "description": "더뷔페 조식 2인 포함",
      "included_skus": [
        "SKU_THE_BUFFET_ADULT_2P"
      ]
    },
    "package": {
      "description": "조식 2인 + 피자힐 5만원 쿠폰 + 사우나 2인",
      "included_skus": [
        "SKU_THE_BUFFET_ADULT_2P",
        "SKU_PIZZA_HILL_COUPON_50K",
        "SKU_SAUNA_ADULT_2P"
      ]
    }
  },
  "stay_lifecycle_constraints": {
    "stay_id_format": "STAY_{weekend_idx}_{building}_{room_seq:03d}_{persona_id}",
    "default_check_in_time": "15:00:00",
    "default_check_out_time": "11:00:00",
    "temporal_rule": "L5 ordered_at MUST satisfy (check_in_time <= ordered_at <= check_out_time)"
  }
}
