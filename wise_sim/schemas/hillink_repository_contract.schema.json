{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walkerhill.example/wise_sim/schemas/hillink-repository-contract-v1.json",
  "title": "WISE Hillink repository source and data contract",
  "type": "object",
  "required": [
    "contract_version",
    "source",
    "coverage",
    "artifacts"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "source": {
      "type": "object",
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "const": "https://github.com/BK8909/Hillink"
        },
        "revision": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "repository_file_count",
        "indexed_file_count",
        "total_size_bytes",
        "format_counts",
        "domain_counts",
        "extraction_status_counts",
        "inventory_complete"
      ],
      "properties": {
        "repository_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "indexed_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "format_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "domain_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "extraction_status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "inventory_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes",
          "sha256",
          "format",
          "domain",
          "extraction_status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "behavioral_evidence",
              "demand_reference",
              "dining_and_capacity",
              "evidence_chain",
              "experiment",
              "journey",
              "ontology",
              "persona_evidence",
              "revenue_reference",
              "scenario",
              "source_code",
              "documentation",
              "media",
              "archive",
              "other"
            ]
          },
          "extraction_status": {
            "enum": ["schema_extracted", "metadata_only", "opaque", "parse_error"]
          },
          "content_contract": {
            "type": ["object", "null"]
          },
          "error": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
